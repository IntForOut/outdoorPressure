<rdf:Description rdf:about="https://intforout.github.io/outdoorPressure#TopometricSurveyGroundTruthPathVincennes2024">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdf:type rdf:resource="https://intforout.github.io/outdoorPressure#Observation"/>
