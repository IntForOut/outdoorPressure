<rdf:Description rdf:about="https://intforout.github.io/outdoorPressure">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
	<owl:imports rdf:resource="http://purl.org/www.umr-lastig.fr/geodata"/>
	<ns:licence rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
	<dct:creator>Bénédicte Bucher</dct:creator>
	<dct:creator>Marie-Dominique Van Damme</dct:creator>
	<dct:title xml:lang="en">Mountain outdoor pressure KG</dct:title>
	<rdfs:comment xml:lang="en">Sets of classes, properties and instances useful to study and mitigate ecological pressure generated by human outdoor activities in mountain</rdfs:comment>
	<rdfs:label xml:lang="en">Mountain outdoor pressure knowledge graph</rdfs:label>
</rdf:Description>
